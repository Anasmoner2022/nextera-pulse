# App
HTTP_ADDR=:8080

# PostgreSQL is the default. Omit DATABASE_URL and the API uses the local URL below.
# SQLite is optional: set DATABASE_URL=file:dev-pulse.sqlite (or :memory:).
# Local: `make dev-up` starts postgres:17 on 127.0.0.1:5432 with these credentials.
DATABASE_URL=postgres://nextera_pulse:nextera_pulse@localhost:5432/nextera_pulse?sslmode=disable
# Used by `go test ./...`; each test creates and drops its own schema here.
TEST_DATABASE_URL=postgres://nextera_pulse:nextera_pulse@localhost:5432/nextera_pulse_test?sslmode=disable
# docker-compose.yml only (the API container builds DATABASE_URL from these)
POSTGRES_DB=nextera_pulse
POSTGRES_USER=nextera_pulse
POSTGRES_PASSWORD=
# 01Edu / Hasura live sync (server-side only; never put these in web/.env)
# Live sync turns on when ZEROONE_ACCESS_TOKEN, or ZEROONE_LOGIN + ZEROONE_PASSWORD, is set.
# 01Edu is the only data source (no file import). Without a credential the API serves what the
# last sync stored (empty on a fresh database); the web app can use VITE_STUDENTS_SOURCE=mock.
ZEROONE_BASE_URL=https://01.nexteraeducation.net
# Defaults to $ZEROONE_BASE_URL/api/graphql-engine/v1/graphql
ZEROONE_GRAPHQL_URL=https://01.nexteraeducation.net/api/graphql-engine/v1/graphql
# Preferred: a Gitea application token created by a campus admin at
# https://01.nexteraeducation.net/user/settings/applications. The API exchanges it at
# GET /api/auth/token?token=... for a Hasura JWT and renews it automatically.
# A ready-made JWT (eyJ...) also works but cannot be renewed when it expires.
ZEROONE_ACCESS_TOKEN=
# Fallback: a service account. POST /api/auth/signin with Basic auth. A normal student
# account only returns its own rows; use a campus admin / admin_read_only account.
ZEROONE_LOGIN=
ZEROONE_PASSWORD=
# Optional x-hasura-role. Sent only if the JWT lists it; otherwise admin_read_only /
# campus-admin roles from the JWT are preferred automatically.
ZEROONE_HASURA_ROLE=
ZEROONE_EVENT_ID=97
# Pulse cohort id = exact 01Edu label name, in priority order (a user in two labels joins the first).
PILOT_COHORTS=4=01 Coding - Second Cohort,1=01 Coding - First Cohort
# Set to "off" to keep credentials configured but stop the scheduler
LIVE_SYNC=

# Sign-in: people sign in with their 01Edu login and password (checked by 01Edu);
# Pulse then issues its own HttpOnly session cookie stored in PostgreSQL.
# Keep true in production (HTTPS). Set false only for plain-HTTP local dev.
SESSION_COOKIE_SECURE=true
# Session lifetime (Go duration, 5m–720h)
SESSION_TTL=12h
# true only when the API sits behind a reverse proxy that sets X-Forwarded-For
# (used for the per-IP sign-in rate limit)
TRUST_PROXY_HEADERS=false

# Jobs (Go duration, minimum 1m)
SYNC_INTERVAL=30m
# Pace snapshots from stored data (no 01Edu calls, no credential needed):
# at API startup, then every SNAPSHOT_INTERVAL. "off" disables the job.
SNAPSHOT_INTERVAL=24h
